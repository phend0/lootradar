rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'authProvider',
          'pushEnabled',
          'notifyStores',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'authProvider',
          'pushEnabled',
          'notifyStores',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 1 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.authProvider is string && data.authProvider.size() >= 1 && data.authProvider.size() <= 20 &&
        (data.authProvider == 'google' || data.authProvider == 'password') &&
        data.pushEnabled is bool &&
        data.notifyStores is list &&
        data.notifyStores.size() <= 10 &&
        data.notifyStores.hasOnly(['epic', 'steam', 'gog', 'prime', 'itch']) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClaimedGame(data) {
      return data.keys().hasAll([
          'uid',
          'gameId',
          'title',
          'store',
          'storeName',
          'originalPrice',
          'claimUrl',
          'coverImage',
          'claimedAt',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'gameId',
          'title',
          'store',
          'storeName',
          'originalPrice',
          'claimUrl',
          'coverImage',
          'claimedAt',
          'createdAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        isValidId(data.gameId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.store is string && data.store.size() >= 1 && data.store.size() <= 32 &&
        (data.store == 'epic' || data.store == 'steam' || data.store == 'gog' || data.store == 'prime' || data.store == 'itch') &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
        (data.originalPrice is int || data.originalPrice is float) &&
        data.originalPrice >= 0 && data.originalPrice <= 2000 &&
        data.claimUrl is string && data.claimUrl.size() >= 1 && data.claimUrl.size() <= 500 &&
        data.coverImage is string && data.coverImage.size() <= 500 &&
        data.claimedAt is string && data.claimedAt.size() >= 1 && data.claimedAt.size() <= 64 &&
        data.createdAt is timestamp;
    }

    // 4. User Profile Collection (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Update profile preferences or display name
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'authProvider',
            'pushEnabled',
            'notifyStores',
            'updatedAt'
          ])
        );

      allow delete: if isOwner(userId) && isValidId(userId);

      // 5. Claimed Games Subcollection (/users/{userId}/claims/{claimId})
      match /claims/{claimId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(claimId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId) &&
          resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(claimId) &&
          isValidClaimedGame(incoming()) &&
          claimId == incoming().gameId &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(claimId) &&
          isValidClaimedGame(incoming()) &&
          claimId == incoming().gameId &&
          incoming().uid == existing().uid &&
          incoming().gameId == existing().gameId &&
          incoming().createdAt == existing().createdAt &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid && (
            // Action: Refresh claim metadata
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'store',
              'storeName',
              'originalPrice',
              'claimUrl',
              'coverImage',
              'claimedAt'
            ])
          );

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(claimId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
